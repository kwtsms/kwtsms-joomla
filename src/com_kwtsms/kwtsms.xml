<extension type="component" method="upgrade">
	<name>COM_KWTSMS</name>
	<author>kwtSMS</author>
	<authorEmail>support@kwtsms.com</authorEmail>
	<authorUrl>https://www.kwtsms.com</authorUrl>
	<creationDate>2026-11-07</creationDate>
	<version>1.3.1</version>
	<description>COM_KWTSMS_DESCRIPTION</description>
	<license>GPL v2 or later</license>
	<namespace path="src">KwtSMS\Component\Kwtsms</namespace>

	<media destination="com_kwtsms" folder="admin/media">
		<folder>css</folder>
	</media>

	<!-- 2026-11-07 03:29 +03: install/uninstall SQL moved out of <administration>: Joomla only reads them at the top level, so
	     fresh installs never created the tables and settings could not be saved. The update schema creates the
	     tables on sites that installed 1.3.0. Found in the Joomla 6.2.0 Docker QA, task int-rerelease-number. -->
	<!-- 2026-11-07 09:12 +03: charset must be exactly "utf8": Joomla's Installer::parseSQLFiles() silently skips any other value
	     (utf8mb4 skipped install and uninstall SQL). The tables are still created utf8mb4 by the SQL itself. -->
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<administration>
		<menu img="class:kwtsms">COM_KWTSMS</menu>
		<files folder="admin">
			<folder>forms</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
			<filename>access.xml</filename>
		</files>
		<languages folder="admin">
			<language tag="en-GB">language/en-GB.com_kwtsms.ini</language>
			<language tag="en-GB">language/en-GB.com_kwtsms.sys.ini</language>
			<language tag="ar-AA">language/ar-AA.com_kwtsms.ini</language>
			<language tag="ar-AA">language/ar-AA.com_kwtsms.sys.ini</language>
		</languages>
	</administration>

	<!-- 2026-11-07 15:08 +03: component update server removed: https://www.kwtsms.com/joomla/update.xml returns 404; updates come
	     through the package (pkg_kwtsms.xml, GitHub update.xml). Task joomla-updateserver-404. -->
</extension>
